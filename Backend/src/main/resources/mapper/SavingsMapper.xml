<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.finview.mapper.SavingsMapper">

    <resultMap id="planMap" type="com.finview.entity.SavingsPlan">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="type" property="type"/>
        <result column="image" property="image"/>
        <result column="current_amount" property="currentAmount"/>
        <result column="target_amount" property="targetAmount"/>
        <result column="start_date" property="startDate"/>
        <result column="target_date" property="targetDate"/>
        <result column="monthly_plan_amount" property="monthlyPlanAmount"/>
        <result column="quote" property="quote"/>
        <result column="note" property="note"/>
        <result column="note_image" property="noteImage"/>
    </resultMap>

    <resultMap id="assetMap" type="com.finview.entity.SavingsAsset">
        <result column="name" property="name"/>
        <result column="amount" property="amount"/>
        <result column="color_var" property="colorVar"/>
    </resultMap>

    <resultMap id="monthPointMap" type="com.finview.entity.SavingsMonthPoint">
        <result column="month" property="month"/>
        <result column="amount" property="amount"/>
    </resultMap>

    <sql id="planColumns">
        id, name, description, type, image, current_amount, target_amount,
        start_date, target_date, monthly_plan_amount, quote, note, note_image
    </sql>

    <select id="selectPlans" resultMap="planMap">
        SELECT <include refid="planColumns"/>
        FROM savings_plan
        ORDER BY FIELD(id, 'total-asset', 'japan-trip', 'buy-computer', 'graduation-trip', 'future-home')
    </select>

    <select id="selectPlanById" resultMap="planMap">
        SELECT <include refid="planColumns"/>
        FROM savings_plan
        WHERE id = #{id}
    </select>

    <select id="selectAssets" resultMap="assetMap">
        SELECT name, amount, color_var
        FROM savings_asset
        WHERE plan_id = #{planId}
        ORDER BY sort_order
    </select>

    <select id="selectSeries" resultMap="monthPointMap">
        SELECT month, amount
        FROM savings_series
        WHERE plan_id = #{planId}
        ORDER BY month
    </select>

</mapper>
