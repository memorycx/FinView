<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.finview.mapper.UserMapper">

    <resultMap id="UserResult" type="com.finview.entity.User">
        <id     property="id"        column="id"/>
        <result property="username"  column="username"/>
        <result property="password"  column="password"/>
        <result property="email"     column="email"/>
        <result property="nickname"  column="nickname"/>
        <result property="role"      column="role"/>
        <result property="enabled"   column="enabled"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByUsername" resultMap="UserResult">
        SELECT * FROM `user` WHERE username = #{username}
    </select>

    <select id="findById" resultMap="UserResult">
        SELECT * FROM `user` WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.finview.entity.User"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `user` (username, password, email, nickname, role, enabled)
        VALUES (#{username}, #{password}, #{email}, #{nickname}, #{role}, #{enabled})
    </insert>

</mapper>
